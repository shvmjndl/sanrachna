# ── App ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────────────
POSTGRES_USER=sanrachna
POSTGRES_PASSWORD=sanrachna_secret
POSTGRES_DB=sanrachna
DATABASE_URL=postgresql+asyncpg://sanrachna:sanrachna_secret@postgres:5432/sanrachna
DATABASE_URL_SYNC=postgresql://sanrachna:sanrachna_secret@postgres:5432/sanrachna

# ── Redis / Celery ───────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Qdrant ───────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=sanrachna_chunks

# ── Sarvam AI (optional — only needed for Indic OCR / scanned docs) ──
SARVAM_API_KEY=
SARVAM_COST_PER_PAGE_INR=0.5
# auto = smart route + fallback chain (local / sarvam / mineru / vision)
DIGITIZATION_PROVIDER=auto
MINERU_ENABLED=false
MINERU_BIN=mineru
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SEC=600
# Vision OCR via LiteLLM — Gemini recommended when OpenAI key lacks vision scope
VISION_OCR_ENABLED=true
VISION_OCR_MODEL=gemini-3.5-flash
VISION_OCR_FALLBACK_MODELS=gemini-2.5-flash
VISION_OCR_MAX_PAGES=20
VISION_OCR_RENDER_SCALE=2.0
VISION_OCR_TIMEOUT_SEC=120
TESSERACT_OCR_ENABLED=true
TESSERACT_OCR_LANG=eng
TESSERACT_OCR_MAX_PAGES=50
TESSERACT_OCR_RENDER_SCALE=2.0
# Ingest performance (parallelism only — same per-page/per-chunk model inputs)
VISION_OCR_CONCURRENCY=5
VISION_OCR_IMAGE_DETAIL=high
TESSERACT_OCR_CONCURRENCY=4
ENTITY_EXTRACTION_CONCURRENCY=1
EMBED_BATCH_CONCURRENCY=2
IMAGE_CAPTION_CONCURRENCY=1
INGEST_COST_LOG_BUFFER=true
AUTO_TRANSLATE_QUERIES=true

# ── LiteLLM Proxy ────────────────────────────────────
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-sanrachna-master
LITELLM_MASTER_KEY=sk-sanrachna-master
LITELLM_EMBEDDING_MODEL=text-embedding-3-small
LITELLM_CHAT_MODEL=gpt-4o-mini

# ── OpenAI (used by LiteLLM proxy) ───────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Google Gemini (vision OCR for scanned PDFs) ──────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Cohere (optional — reranking; LLM fallback if unset) ──
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
ENABLE_COHERE_RERANK=false

# ── Storage ──────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
OUTPUT_DIR=/app/data/outputs

# ── Streamlit ────────────────────────────────────────
SANRACHNA_API_URL=http://api:8000
